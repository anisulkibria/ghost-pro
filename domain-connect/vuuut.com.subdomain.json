{
  "providerId": "vuuut.com",
  "providerName": "Vuuut Pro",
  "serviceId": "subdomain",
  "serviceName": "Vuuut Pro Subdomain",
  "version": 1,
  "description": "Connect your domain to a Vuuut Pro site.",
  "syncPubKeyDomain": "domainconnect.vuuut.com",
  "syncRedirectDomain": "vuuut.com",
  "hostRequired": true,
  "variableDescription": "%target% contains CNAME target configured by the Vuuut Pro deployment. %ownership% contains domain ownership token without the ghost-pro-verify= prefix.",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%target%",
      "ttl": 600
    },
    {
      "type": "TXT",
      "host": "_ghost-pro-challenge",
      "data": "ghost-pro-verify=%ownership%",
      "ttl": 600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "ghost-pro-verify="
    }
  ]
}
