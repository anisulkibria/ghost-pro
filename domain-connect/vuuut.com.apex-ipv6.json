{
  "providerId": "vuuut.com",
  "providerName": "Vuuut Pro",
  "serviceId": "apex-ipv6",
  "serviceName": "Vuuut Pro Root domain (IPv6)",
  "version": 1,
  "description": "Connect your domain to a Vuuut Pro site.",
  "syncPubKeyDomain": "domainconnect.vuuut.com",
  "syncRedirectDomain": "vuuut.com",
  "variableDescription": "%ipv6% contains public IPv6 address of the Vuuut Pro deployment. %ownership% contains domain ownership token without the ghost-pro-verify= prefix.",
  "records": [
    {
      "type": "AAAA",
      "host": "@",
      "pointsTo": "%ipv6%",
      "ttl": 600
    },
    {
      "type": "TXT",
      "host": "_ghost-pro-challenge",
      "data": "ghost-pro-verify=%ownership%",
      "ttl": 600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "ghost-pro-verify="
    }
  ]
}
