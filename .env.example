# Per-machine settings for ./run.sh. Copy to .env (gitignored) and edit.
# A variable already set in the shell wins over this file.
# PRO_* variables are read by the platform itself as config overrides
# (PRO_<SECTION>__<KEY>), so this file can live anywhere the checkout does and
# nothing in the tree has to name this machine.

# Deployment directory: pro.json, data/, tenant sites, logs.
# Relative to this directory. Default: ./run
# PRO_DIR=run

# The Vuuut checkout tenant sites run from. Unset means the platform looks for
# one next to this directory (vuuut, Vuuut, ... see crates/pro-core/src/checkout.rs),
# which is the normal side-by-side clone. Set it when the CMS lives elsewhere.
# Absolute, or relative to this directory.
# VUUUT_DIR=../vuuut

# The same two paths the platform reads, if you would rather set them directly.
# These win over VUUUT_DIR. Relative values resolve against PRO_DIR.
# PRO_PATHS__GHOST_BINARY=/opt/vuuut/target/release/ghost
# PRO_PATHS__THEME_SOURCE=/opt/vuuut/content/themes

# Edge port and platform URL (pro.json server.port / url).
# PRO_SERVER__PORT=8080
# PRO_URL=http://pro.localhost:8080
# PRO_SUBDOMAIN_BASE=localhost

# Optional, tests only: run migration/trigger tests against MySQL as well.
# PRO_TEST_MYSQL_URL=mysql://user:password@127.0.0.1:3306/pro_test
